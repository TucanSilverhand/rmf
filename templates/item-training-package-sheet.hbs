{{!--
  RMF Training Package Item Sheet Template - FoundryVTT v13 Compatible
  ApplicationV2 with HandlebarsApplicationMixin
  Two-tab layout: read-only "details" + editable "advanced".
  NOTE: Do NOT wrap with <form>; ApplicationV2 provides the root form.
--}}

<div class="{{cssClass}} rmf-item-sheet training-package-sheet-root">
  <div class="sheet-main-container training-package-sheet">
    {{> "parts/item-trainingpackage-navigation"}}
    <div class="sheet-content">
      {{> "parts/item-trainingpackage-header"}}
      <section class="sheet-body">
        <div class="sheet-body-inner" data-rich="true">
          {{> "parts/item-trainingpackage-details"}}
          {{> "parts/item-trainingpackage-managed"}}
          {{> "parts/item-trainingpackage-advanced"}}
        </div>
      </section>
    </div>
  </div>
</div>
