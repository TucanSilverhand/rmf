{{!-- Chat template for stat rolls --}}
<div class="rmf-chat-card stat-roll">
  <div class="card-content">
    <div class="roll-overview">
      <div class="overview-row">
        <span class="label">{{localize "RMF.Chat.Dice"}}</span>
        <span class="value">{{baseRoll}}</span>
      </div>
      {{#if exploded}}
        <div class="overview-row open-ended">
          <span class="label">{{localize "RMF.Chat.OpenEnded"}}</span>
          <span class="value monospace">{{diceChain}}</span>
        </div>
      {{/if}}
      {{#if umLabel}}
        <div class="overview-row unmodified">
          <span class="label">{{localize "RMF.Chat.Unmodified"}}</span>
          <span class="value">{{umLabel}}</span>
        </div>
      {{/if}}
    </div>

    <details class="total-breakdown-up">
      <summary class="roll-result">
        <strong>{{localize "RMF.Chat.TotalResult"}}</strong>
        <span class="total-value">{{roll.total}}</span>
      </summary>
      <div class="up-panel">
        <div class="breakdown-grid">
          <span class="breakdown-label">{{localize "RMF.Chat.Formula"}}</span>
          <span class="breakdown-value monospace">{{formula}}</span>
          <span class="breakdown-label">{{localize "RMF.Chat.Applied"}}</span>
          <span class="breakdown-value monospace">
            {{#if hasBonus}}
              {{baseRoll}} {{bonusOperator}} {{bonusAbs}}
            {{else}}
              {{baseRoll}}
            {{/if}}
          </span>
        </div>
      </div>
    </details>
  </div>
</div>
