{{!--
  RMF Skill Item Sheet Details Partial
  Read-only summary mirroring item-category-details.hbs (basic tab),
  adapted for skills: no stat block; the totals row is
  Total Ranks | Total Category | Profession | Spec 1 | Spec 2 | Total.
--}}

<div class="tab details-section" data-tab="details" style="display: block;">
  <div class="description-preview ProseMirror">
    {{{enrichedDescription}}}
  </div>

  <div class="summary-wrapper">
    <table class="summary-table basic-info-table">
      <thead>
        <tr>
          <th scope="col">{{localize "RMF.Skill.RankBonusProgression"}}</th>
          <th scope="col">{{localize "RMF.Category.DPCostSummary"}}</th>
          <th scope="col">{{localize "RMF.Skills.Category"}}</th>
          <th scope="col">{{localize "RMF.Category.Ranks"}}</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>
            <input type="text" value="{{rankBonusProgressionLabel}}" readonly />
          </td>
          <td>
            <input type="text" value="{{dpCostSummary}}" readonly />
          </td>
          <td>
            <input type="text" value="{{selectedCategory}}" readonly />
          </td>
          <td>
            <input type="number" value="{{totalRanks}}" readonly data-dtype="Number" inputmode="numeric" />
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="summary-wrapper">
    <table class="summary-table basic-totals-table">
      <thead>
        <tr>
          <th scope="col">{{localize "RMF.Skill.TotalRankBonus"}}</th>
          <th class="operator-column" aria-hidden="true"></th>
          <th scope="col">{{localize "RMF.Skill.TotalCategoryBonus"}}</th>
          <th class="operator-column" aria-hidden="true"></th>
          <th scope="col">{{localize "RMF.Category.ProfessionBonus"}}</th>
          <th class="operator-column" aria-hidden="true"></th>
          <th scope="col">{{localize "RMF.Category.Spec1Bonus"}}</th>
          <th class="operator-column" aria-hidden="true"></th>
          <th scope="col">{{localize "RMF.Category.Spec2Bonus"}}</th>
          <th class="operator-column equals-column" aria-hidden="true"></th>
          <th scope="col">&nbsp;&nbsp;{{localize "RMF.Category.TotalBonus"}}</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td title="{{rankBonusSummary}}">
            <input type="number" value="{{totalRankBonus}}" step="0.5" readonly data-dtype="Number" inputmode="numeric" />
          </td>
          <td class="operator-column" aria-hidden="true">+</td>
          <td>
            <input type="number" value="{{categoryBonus}}" step="0.5" readonly data-dtype="Number" inputmode="numeric" />
          </td>
          <td class="operator-column" aria-hidden="true">+</td>
          <td>
            <input type="number" value="{{professionBonus}}" step="0.5" readonly data-dtype="Number" inputmode="numeric" />
          </td>
          <td class="operator-column" aria-hidden="true">+</td>
          <td>
            <input type="number" value="{{spec1Bonus}}" step="0.5" readonly data-dtype="Number" inputmode="numeric" />
          </td>
          <td class="operator-column" aria-hidden="true">+</td>
          <td>
            <input type="number" value="{{spec2Bonus}}" step="0.5" readonly data-dtype="Number" inputmode="numeric" />
          </td>
          <td class="operator-column equals-column" aria-hidden="true">=</td>
          <td title="{{totalRankBonus}} + {{categoryBonus}} + {{professionBonus}} + {{spec1Bonus}} + {{spec2Bonus}}">
            &nbsp;&nbsp;<input type="number" value="{{totalBonus}}" step="0.5" readonly data-dtype="Number" inputmode="numeric" />
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
