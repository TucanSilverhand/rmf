{{!--
  RMF Profession Item Sheet Details Partial
  Read-only summary view of all profession data.
--}}

<div class="tab details-section" data-group="primary-tabs" data-tab="details" style="display: block;">

  {{!-- Description (enriched, read-only) --}}
  <div class="description-preview ProseMirror">
    {{{enrichedDescription}}}
  </div>

  {{!-- Source --}}
  <div class="summary-wrapper">
    <table class="summary-table basic-info-table">
      <thead>
        <tr>
          <th scope="col">{{localize "RMF.Category.Source"}}</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><input type="text" value="{{system.fromBook}}" readonly /></td>
        </tr>
      </tbody>
    </table>
  </div>

  {{!-- Prime stats: persistidos como chXxx; mostramos el label localizado
       que el sheet pre-resolvió contra RMF.Stats.<chXxx>. Layout en doble
       columna usando .prime-stats-grid (misma regla que el advanced tab). --}}
  <div class="summary-wrapper">
    <h3>{{localize "RMF.Profession.PrimeStats"}}</h3>
    {{#if primeStatRows.length}}
    <div class="prime-stats-grid">
      {{#each primeStatRows as |row|}}
        <div class="prime-stat-row prime-stat-readonly">{{row.label}}</div>
      {{/each}}
    </div>
    {{else}}
    <em>{{localize "RMF.Profession.None"}}</em>
    {{/if}}
  </div>

  {{!-- Professional bonuses — two-column layout --}}
  <div class="summary-wrapper">
    <h3>{{localize "RMF.Profession.ProfessionalBonuses"}}</h3>
    {{#if system.professionalBonuses.length}}
    <div class="two-col-tables">
      <table class="summary-table">
        <thead>
          <tr>
            <th>{{localize "RMF.Profession.BonusName"}}</th>
            <th>{{localize "RMF.Profession.BonusValue"}}</th>
          </tr>
        </thead>
        <tbody>
          {{#each professionalBonusesLeft as |row|}}
          <tr>
            <td><input type="text"   value="{{row.name}}"  readonly /></td>
            <td><input type="number" value="{{row.bonus}}" readonly data-dtype="Number" inputmode="numeric" /></td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      <table class="summary-table">
        <thead>
          <tr>
            <th>{{localize "RMF.Profession.BonusName"}}</th>
            <th>{{localize "RMF.Profession.BonusValue"}}</th>
          </tr>
        </thead>
        <tbody>
          {{#each professionalBonusesRight as |row|}}
          <tr>
            <td><input type="text"   value="{{row.name}}"  readonly /></td>
            <td><input type="number" value="{{row.bonus}}" readonly data-dtype="Number" inputmode="numeric" /></td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    {{else}}
    <em>{{localize "RMF.Profession.None"}}</em>
    {{/if}}
  </div>

  {{!-- Everyman / Occupational / Restricted skill lists — 2-column grid
       so the typically-long lists don't read as a tall stack. Same
       .profession-skill-grid rule that the advanced tab uses. --}}
  <div class="summary-wrapper">
    <h3>{{localize "RMF.Profession.EverymanSkills"}}</h3>
    {{#if system.everymanSkills.length}}
    <div class="profession-skill-grid">
      {{#each system.everymanSkills as |entry|}}
        <div class="profession-skill-row profession-skill-readonly">{{entry.name}}</div>
      {{/each}}
    </div>
    {{else}}
    <em>{{localize "RMF.Profession.None"}}</em>
    {{/if}}
  </div>

  <div class="summary-wrapper">
    <h3>{{localize "RMF.Profession.OccupationalSkills"}}</h3>
    {{#if system.occupationalSkills.length}}
    <div class="profession-skill-grid">
      {{#each system.occupationalSkills as |entry|}}
        <div class="profession-skill-row profession-skill-readonly">{{entry.name}}</div>
      {{/each}}
    </div>
    {{else}}
    <em>{{localize "RMF.Profession.None"}}</em>
    {{/if}}
  </div>

  <div class="summary-wrapper">
    <h3>{{localize "RMF.Profession.RestrictedSkills"}}</h3>
    {{#if system.restrictedSkills.length}}
    <div class="profession-skill-grid">
      {{#each system.restrictedSkills as |entry|}}
        <div class="profession-skill-row profession-skill-readonly">{{entry.name}}</div>
      {{/each}}
    </div>
    {{else}}
    <em>{{localize "RMF.Profession.None"}}</em>
    {{/if}}
  </div>

  {{!-- Category prices (DP cost) — two-column layout for compactness --}}
  <div class="summary-wrapper">
    <h3>{{localize "RMF.Profession.CategoryPrice"}}</h3>
    {{#if system.categoryPrice.length}}
    <div class="two-col-tables">
      <table class="summary-table dp-cost-table">
        <thead>
          <tr>
            <th>{{localize "RMF.Skills.Category"}}</th>
            <th>P1</th><th>P2</th><th>P3</th>
          </tr>
        </thead>
        <tbody>
          {{#each categoryPriceLeft as |row|}}
          <tr>
            <td><input type="text" value="{{row.name}}" readonly /></td>
            <td><input type="number" value="{{row.price1}}" readonly data-dtype="Number" inputmode="numeric" /></td>
            <td><input type="number" value="{{row.price2}}" readonly data-dtype="Number" inputmode="numeric" /></td>
            <td><input type="number" value="{{row.price3}}" readonly data-dtype="Number" inputmode="numeric" /></td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      <table class="summary-table dp-cost-table">
        <thead>
          <tr>
            <th>{{localize "RMF.Skills.Category"}}</th>
            <th>P1</th><th>P2</th><th>P3</th>
          </tr>
        </thead>
        <tbody>
          {{#each categoryPriceRight as |row|}}
          <tr>
            <td><input type="text" value="{{row.name}}" readonly /></td>
            <td><input type="number" value="{{row.price1}}" readonly data-dtype="Number" inputmode="numeric" /></td>
            <td><input type="number" value="{{row.price2}}" readonly data-dtype="Number" inputmode="numeric" /></td>
            <td><input type="number" value="{{row.price3}}" readonly data-dtype="Number" inputmode="numeric" /></td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    {{else}}
    <em>{{localize "RMF.Profession.None"}}</em>
    {{/if}}
  </div>

  {{!-- Spell prices — two-column layout --}}
  <div class="summary-wrapper">
    <h3>{{localize "RMF.Profession.SpellPrice"}}</h3>
    {{#if system.spellPrice.length}}
    <div class="two-col-tables">
      <table class="summary-table dp-cost-table">
        <thead>
          <tr>
            <th>{{localize "RMF.Profession.SpellGroup"}}</th>
            <th>P1</th><th>P2</th><th>P3</th>
          </tr>
        </thead>
        <tbody>
          {{#each spellPriceLeft as |row|}}
          <tr>
            <td><input type="text"   value="{{row.name}}"   readonly /></td>
            <td><input type="number" value="{{row.price1}}" readonly data-dtype="Number" inputmode="numeric" /></td>
            <td><input type="number" value="{{row.price2}}" readonly data-dtype="Number" inputmode="numeric" /></td>
            <td><input type="number" value="{{row.price3}}" readonly data-dtype="Number" inputmode="numeric" /></td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      <table class="summary-table dp-cost-table">
        <thead>
          <tr>
            <th>{{localize "RMF.Profession.SpellGroup"}}</th>
            <th>P1</th><th>P2</th><th>P3</th>
          </tr>
        </thead>
        <tbody>
          {{#each spellPriceRight as |row|}}
          <tr>
            <td><input type="text"   value="{{row.name}}"   readonly /></td>
            <td><input type="number" value="{{row.price1}}" readonly data-dtype="Number" inputmode="numeric" /></td>
            <td><input type="number" value="{{row.price2}}" readonly data-dtype="Number" inputmode="numeric" /></td>
            <td><input type="number" value="{{row.price3}}" readonly data-dtype="Number" inputmode="numeric" /></td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    {{else}}
    <em>{{localize "RMF.Profession.None"}}</em>
    {{/if}}
  </div>

  {{!-- Training packages — two-column layout --}}
  <div class="summary-wrapper">
    <h3>{{localize "RMF.Profession.TrainingPackages"}}</h3>
    {{#if system.trainingPackages.length}}
    <div class="two-col-tables">
      <table class="summary-table">
        <thead>
          <tr>
            <th>{{localize "RMF.Profession.PackageName"}}</th>
            <th>{{localize "RMF.Profession.PackageCost"}}</th>
          </tr>
        </thead>
        <tbody>
          {{#each trainingPackagesLeft as |row|}}
          <tr>
            <td><input type="text" value="{{row.name}}" readonly /></td>
            <td><input type="number" value="{{row.dpCost}}" readonly data-dtype="Number" inputmode="numeric" /></td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      <table class="summary-table">
        <thead>
          <tr>
            <th>{{localize "RMF.Profession.PackageName"}}</th>
            <th>{{localize "RMF.Profession.PackageCost"}}</th>
          </tr>
        </thead>
        <tbody>
          {{#each trainingPackagesRight as |row|}}
          <tr>
            <td><input type="text" value="{{row.name}}" readonly /></td>
            <td><input type="number" value="{{row.dpCost}}" readonly data-dtype="Number" inputmode="numeric" /></td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    {{else}}
    <em>{{localize "RMF.Profession.None"}}</em>
    {{/if}}
  </div>

</div>
