{{!--
  RMF Spell List Item Sheet Navigation Tabs
  Vertical sidebar: read-only "details", editable "advanced",
  read-only "key" (Spell Description Key legend).
--}}

<nav class="sheet-tabs tabs vertical-tabs" data-group="primary-tabs">
  <a class="item nav-item active" data-tab="details" data-group="primary-tabs" title="{{localize 'RMF.Tabs.Details'}}">
    <span class="tab-icon">ℹ️</span>
  </a>
  <a class="item nav-item" data-tab="advanced" data-group="primary-tabs" title="{{localize 'RMF.Tabs.Advanced'}}">
    <span class="tab-icon">⚙️</span>
  </a>
  <a class="item nav-item" data-tab="key" data-group="primary-tabs" title="{{localize 'RMF.SpellList.KeyTab'}}">
    <span class="tab-icon">🗝️</span>
  </a>
</nav>
