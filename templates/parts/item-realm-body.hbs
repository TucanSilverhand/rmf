{{!--
  RMF Realm Item Sheet Body — two tabs:
   - "view" (read-only): power-point track, stat bonuses, enriched description.
   - "edit" (editable): selectors + description editor.
--}}

{{!-- Ver (read-only) --}}
<div class="tab realm-view" data-group="primary-tabs" data-tab="view" style="display: block;">
  <div class="summary-wrapper">
    <table class="summary-table">
      <tbody>
        <tr><th scope="row">{{localize "RMF.Realm.PowerPointsType"}}</th><td>{{powerPointsTypeLabel}}</td></tr>
        <tr><th scope="row">{{localize "RMF.Category.Stat1"}}</th><td>{{stat1Label}}</td></tr>
        <tr><th scope="row">{{localize "RMF.Category.Stat2"}}</th><td>{{stat2Label}}</td></tr>
        <tr><th scope="row">{{localize "RMF.Category.Stat3"}}</th><td>{{stat3Label}}</td></tr>
      </tbody>
    </table>
  </div>
  {{#if enrichedDescription}}
  <div class="summary-wrapper">
    <h3>{{localize "RMF.Description"}}</h3>
    <div class="rmf-readonly-description">{{{enrichedDescription}}}</div>
  </div>
  {{/if}}
</div>

{{!-- Editar (editable) --}}
<div class="tab realm-edit" data-group="primary-tabs" data-tab="edit" style="display: none;">
  <div class="realm-body">

    <fieldset class="form-group">
      <legend>{{localize "RMF.Realm.PowerPointsType"}}</legend>
      <div class="flexrow">
        <div class="resource">
          <label class="sr-only">{{localize "RMF.Realm.PowerPointsType"}}</label>
          <select name="system.powerPointsType">
            {{#each powerPointsTypeOptions as |option|}}
              <option value="{{option.value}}" {{#if (rmfEq ../selectedPowerPointsType option.value)}}selected{{/if}}>{{option.label}}</option>
            {{/each}}
          </select>
        </div>
      </div>
    </fieldset>

    <fieldset class="form-group">
      <legend>{{localize "RMF.Category.StatBonus"}}</legend>
      <div class="flexrow">
        <div class="resource">
          <label>{{localize "RMF.Category.Stat1"}}</label>
          <select name="system.statBonus.stat1">
            {{#each statOptions}}
            <option value="{{this.value}}" {{#if (rmfEq ../selectedStat1 this.value)}}selected{{/if}}>{{this.label}}</option>
            {{/each}}
          </select>
        </div>
        <div class="resource">
          <label>{{localize "RMF.Category.Stat2"}}</label>
          <select name="system.statBonus.stat2">
            {{#each statOptions}}
            <option value="{{this.value}}" {{#if (rmfEq ../selectedStat2 this.value)}}selected{{/if}}>{{this.label}}</option>
            {{/each}}
          </select>
        </div>
        <div class="resource">
          <label>{{localize "RMF.Category.Stat3"}}</label>
          <select name="system.statBonus.stat3">
            {{#each statOptions}}
            <option value="{{this.value}}" {{#if (rmfEq ../selectedStat3 this.value)}}selected{{/if}}>{{this.label}}</option>
            {{/each}}
          </select>
        </div>
      </div>
    </fieldset>

    <div class="form-group ProseMirror">
      <label>{{localize "RMF.Description"}}</label>
      {{formInput descriptionField enriched=enrichedDescription value=system.description name="system.description" toggled=true disabled=(not editable)}}
    </div>

  </div>
</div>
