{{!--
  RMF Realm Item Sheet Body Partial
  Power Points type selector + description editor.
--}}

<div class="realm-body">

  <fieldset class="form-group">
    <legend>{{localize "RMF.Realm.PowerPointsType"}}</legend>
    <div class="flexrow">
      <div class="resource">
        <label class="sr-only">{{localize "RMF.Realm.PowerPointsType"}}</label>
        <select name="system.powerPointsType">
          {{#each powerPointsTypeOptions as |option|}}
            <option value="{{option.value}}" {{#if (eq ../selectedPowerPointsType option.value)}}selected{{/if}}>{{option.label}}</option>
          {{/each}}
        </select>
      </div>
    </div>
  </fieldset>

  <fieldset class="form-group">
    <legend>{{localize "RMF.Category.StatBonus"}}</legend>
    <div class="flexrow">
      <div class="resource">
        <label>{{localize "RMF.Category.Stat1"}}</label>
        <select name="system.statBonus.stat1">
          {{#each statOptions}}
          <option value="{{this.value}}" {{#if (eq ../selectedStat1 this.value)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
      </div>
      <div class="resource">
        <label>{{localize "RMF.Category.Stat2"}}</label>
        <select name="system.statBonus.stat2">
          {{#each statOptions}}
          <option value="{{this.value}}" {{#if (eq ../selectedStat2 this.value)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
      </div>
      <div class="resource">
        <label>{{localize "RMF.Category.Stat3"}}</label>
        <select name="system.statBonus.stat3">
          {{#each statOptions}}
          <option value="{{this.value}}" {{#if (eq ../selectedStat3 this.value)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
      </div>
    </div>
  </fieldset>

  <div class="form-group ProseMirror">
    <label>{{localize "RMF.Description"}}</label>
    {{formInput descriptionField enriched=enrichedDescription value=system.description name="system.description" toggled=true disabled=(not editable)}}
  </div>

</div>
