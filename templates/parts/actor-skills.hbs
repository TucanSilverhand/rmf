{{!--
  RMF Actor Sheet Skills Tab
  Categories list with skills nested by category and roll functionality
--}}

<div class="tab skills-section" data-tab="skills" style="display: none;">
  <section class="skills-section">

    {{!-- Categories List --}}
    <div class="categories-container">
      <h3 class="section-title">{{localize "RMF.Skills.Categories"}}</h3>

      {{#if categoriesWithSkills.length}}
        <div class="categories-list">
          {{#each categoriesWithSkills as |group|}}
            <div class="category-block">
              <div class="category-item" data-item-id="{{group.category.id}}" title="{{group.category.name}} -> Ranks: {{group.category.system.totalRankBonus}} + Stats: {{group.category.system.totalStatsBonus}} + Prof: {{group.category.system.profBonus}} + S1: {{group.category.system.spec1Bonus}} + S2: {{group.category.system.spec2Bonus}} --> Total: {{group.category.system.totalBonus}}">
                <a class="category-name rollable"
                   data-action="rollCategory"
                   data-item-id="{{group.category.id}}"
                   aria-label="{{localize 'RMF.Actions.Roll'}} {{group.category.name}}">
                  {{group.category.name}}
                </a>
                {{#if group.showNoSkill}}
                  <a class="category-no-skill rollable"
                     data-action="rollCategoryNoSkill"
                     data-item-id="{{group.category.id}}"
                     title="{{group.category.name}} -> Ranks: {{group.category.system.totalRankBonus}} + Stats: {{group.category.system.totalStatsBonus}} + Prof: {{group.category.system.profBonus}} + S1: {{group.category.system.spec1Bonus}} + S2: {{group.category.system.spec2Bonus}} + No skill: -15 --> Total: {{group.noSkillTotal}}"
                     aria-label="{{localize 'RMF.Actions.Roll'}} {{group.category.name}} ({{localize 'RMF.NoSkill'}})">
                    <i class="fas fa-times" aria-hidden="true"></i>
                  </a>
                {{/if}}
                <span class="category-total">{{group.category.system.totalBonus}}</span>
              </div>

              {{#if group.skills.length}}
                <ul class="skills-list">
                  {{#each group.skills as |skill|}}
                    <li class="skill-item" data-item-id="{{skill.id}}" title="{{skill.name}} -> Ranks: {{skill.system.totalRankBonus}} + Category: {{skill.system.categoryBonus}} + Prof: {{skill.system.profBonus}} + S1: {{skill.system.spec1Bonus}} + S2: {{skill.system.spec2Bonus}} --> Total: {{skill.system.totalBonus}}">
                      <a class="skill-name rollable"
                         data-action="rollSkill"
                         data-item-id="{{skill.id}}"
                         aria-label="{{localize 'RMF.Actions.Roll'}} {{skill.name}}">
                        {{skill.name}}
                      </a>
                      <span class="skill-total" title="{{localize 'RMF.Category.TotalBonus'}}">{{skill.system.totalBonus}}</span>
                    </li>
                  {{/each}}
                </ul>
              {{/if}}
            </div>
          {{/each}}
        </div>
      {{else}}
        <div class="empty-message">
          <p>{{localize "RMF.Skills.NoCategories"}}</p>
          <p class="hint">{{localize "RMF.Skills.NoCategoriesHint"}}</p>
        </div>
      {{/if}}
    </div>

    {{#if uncategorizedSkills.length}}
      <div class="categories-container uncategorized">
        <h3 class="section-title">{{localize "RMF.Skills.Uncategorized"}}</h3>
        <ul class="skills-list">
          {{#each uncategorizedSkills as |skill|}}
            <li class="skill-item" data-item-id="{{skill.id}}" title="{{skill.name}} -> Ranks: {{skill.system.totalRankBonus}} + Category: {{skill.system.categoryBonus}} + Prof: {{skill.system.profBonus}} + S1: {{skill.system.spec1Bonus}} + S2: {{skill.system.spec2Bonus}} --> Total: {{skill.system.totalBonus}}">
              <a class="skill-name rollable"
                 data-action="rollSkill"
                 data-item-id="{{skill.id}}"
                 aria-label="{{localize 'RMF.Actions.Roll'}} {{skill.name}}">
                {{skill.name}}
              </a>
              <small class="skill-category-hint" title="{{skill.system.category}}">({{skill.system.category}})</small>
              <span class="skill-total" title="{{localize 'RMF.Category.TotalBonus'}}">{{skill.system.totalBonus}}</span>
            </li>
          {{/each}}
        </ul>
      </div>
    {{/if}}

  </section>
</div>
