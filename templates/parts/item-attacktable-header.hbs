{{!--
  RMF Attack Table Sheet Header Partial
  Table name + image + a subtitle with the bridge fields (book id,
  critical type, fumble band). The name input lives here so it stays
  visible across both tabs.
--}}

<header class="sheet-header">
  <div class="header-row">
    <img class="profile-img"
         src="{{item.img}}"
         alt="{{item.name}}"
         data-edit="img"
         data-action="pickImage"
         title="{{item.name}}"
         height="64"
         width="64"/>

    <div class="header-fields">
      <h1 class="item-name">
        <label class="sr-only" for="attacktable_name">{{localize "RMF.AttackTable.NamePlaceholder"}}:</label>
        <input id="attacktable_name"
               name="name"
               type="text"
               value="{{item.name}}"
               placeholder="{{localize 'RMF.AttackTable.NamePlaceholder'}}"
               autocomplete="off"/>
      </h1>
      <div class="attacktable-subtitle">
        {{#if system.tableId}}<span class="ref">{{system.tableId}}</span>{{/if}}
        {{#if system.critType}}<span class="badge">{{localize 'RMF.AttackTable.CritType'}}: {{system.critType}}</span>{{/if}}
        <span class="badge">{{localize 'RMF.AttackTable.FumbleRange'}}: {{system.fumbleRange.min}}-{{system.fumbleRange.max}}</span>
        <span class="badge">{{system.rowCount}} {{localize 'RMF.AttackTable.Rows'}} × {{system.columns.length}} {{localize 'RMF.AttackTable.Columns'}}</span>
      </div>
    </div>
  </div>
</header>
