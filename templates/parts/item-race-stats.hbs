{{!-- 
  RMF Race Item Sheet Stats Partial
  Race stat bonuses table
--}}

<div class="tab stats-section" data-tab="stats">
  <section class="stats-section">

    
    <div class="stats-table-container">
      <table class="stats-table">
        <thead>
          <tr>
            <th>{{localize "RMF.StatLabels.Attribute"}}</th>
            <th>{{localize "RMF.StatLabels.Bonus"}}</th>
          </tr>
        </thead>
        <tbody>
          {{#each statBonuses as |stat key|}}
          <tr>
            <td class="stat-label">{{stat.label}}</td>
            <td class="stat-input">
              <input type="number" 
                     name="system.stats.{{key}}" 
                     value="{{stat.value}}" 
                     min="-99"
                     max="99"
                     step="1"
                     inputmode="numeric"
                     placeholder="0"
                     data-dtype="Number"/>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    
  </section>
</div>
