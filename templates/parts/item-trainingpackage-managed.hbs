{{!--
  RMF Training Package Item Sheet — Managed Partial
  Per-character management: the level the package was taken at + apply/recover.
  Only meaningful when the package is embedded on a character.
--}}

<div class="tab managed-section" data-group="primary-tabs" data-tab="managed" style="display: none;">
  {{#if isOnActor}}
  <div class="summary-wrapper rmf-tp-apply">
    <h3>{{localize "RMF.TrainingPackage.Application"}}</h3>
    <div class="rmf-tp-apply-row">
      <span class="rmf-tp-status {{#if applied}}is-applied{{else}}is-pending{{/if}}">
        {{#if applied}}{{localize "RMF.TrainingPackage.AppliedBadge"}}{{else}}{{localize "RMF.TrainingPackage.NotAppliedBadge"}}{{/if}}
      </span>

      <label class="rmf-tp-level">
        {{localize "RMF.TrainingPackage.TakenAtLevel"}}
        <input type="number"
               name="system.takenAtLevel"
               value="{{takenAtLevel}}"
               min="0"
               max="{{actorLevel}}"
               data-dtype="Number"
               inputmode="numeric"
               {{#if applied}}readonly{{/if}} />
      </label>

      <button type="button"
              class="rmf-tp-btn apply"
              data-action="applyTrainingPackage"
              {{#if applied}}disabled{{/if}}>
        <i class="fas fa-circle-check"></i> {{localize "RMF.TrainingPackage.Apply"}}
      </button>

      <button type="button"
              class="rmf-tp-btn recover"
              data-action="recoverTrainingPackage"
              {{#unless applied}}disabled{{/unless}}>
        <i class="fas fa-rotate-left"></i> {{localize "RMF.TrainingPackage.Recover"}}
      </button>
    </div>
    <p class="rmf-tp-apply-hint">{{localize "RMF.TrainingPackage.ApplyHint"}}</p>
  </div>
  {{else}}
  <p class="no-items">{{localize "RMF.TrainingPackage.ManagedOnActorOnly"}}</p>
  {{/if}}
</div>
