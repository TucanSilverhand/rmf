{{!-- 
  RMF Race Item Sheet Background Partial
  Race description, racial abilities and background options
--}}

<div class="tab background-section" data-tab="background" style="display: block;">
  <section class="background-section">
    
    <!-- Description Section -->
    <div class="form-group description-editor-group">
      <label>{{localize "RMF.Description"}}</label>
      <div class="editor-container description-editor">
        <textarea name="system.description" 
                  class="rmf-rich-editor" 
                  style="height: 210px; resize: vertical;"
                  placeholder="{{localize 'RMF.DescriptionPlaceholder'}}">{{system.description}}</textarea>
      </div>
    </div>
    
    <!-- Racial Abilities Section -->
    <div class="form-group abilities-editor-group">
      <label>{{localize "RMF.RacialAbilities"}}</label>
      <div class="editor-container abilities-editor">
        <textarea name="system.racialAbilities" 
                  class="rmf-rich-editor" 
                  style="height: 100px; resize: vertical;"
                  placeholder="{{localize 'RMF.RacialAbilitiesPlaceholder'}}">{{system.racialAbilities}}</textarea>
      </div>
    </div>

    <!-- Background Options Section -->
    <div class="background-options-container">
      <div class="background-table-container">
        <table class="background-table">
          <tbody>
            <tr>
              <td class="background-label">{{localize "RMF.BackgroundOptions"}}</td>
              <td class="background-input">
      <input type="number"
        name="system.backgroundOptions"
        value="{{system.backgroundOptions}}"
        min="0"
        max="999"
        step="1"
        inputmode="numeric"
        placeholder="0"
        data-dtype="Number"/>
              </td>
            </tr>
            <tr>
              <td class="background-label">{{localize "RMF.Category.Source"}}</td>
              <td class="background-input">
                <input type="text"
                  name="system.fromBook"
                  value="{{system.fromBook}}"
                  placeholder="basic"
                  autocomplete="off" />
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
    
  </section>
</div>
