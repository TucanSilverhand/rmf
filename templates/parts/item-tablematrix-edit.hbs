{{!--
  RMF Matrix Table Sheet — editable matrix (Editar tab). Owner edits the
  bridge fields, columns, every band (roll range + per-column text/effects),
  and the legend directly. Array-backed fields are rewritten whole by the
  sheet's _onFieldChange (Foundry mangles deep array-path updates).
--}}
<div class="tab criticaltable-edit" data-group="primary-tabs" data-tab="edit" style="display: none;">
  {{#if editable}}

  {{!-- Bridge fields --}}
  <div class="summary-wrapper">
    <h3>{{localize "RMF.AttackTable.Meta"}}</h3>
    <div class="two-col-tables">
      <table class="summary-table">
        <tbody>
          <tr><th scope="row">{{localize "RMF.AttackTable.TableId"}}</th>
            <td><input type="text" name="system.tableId" value="{{system.tableId}}"/></td></tr>
          {{#if system.critType}}
          <tr><th scope="row">{{localize "RMF.AttackTable.CritType"}}</th>
            <td><input type="text" name="system.critType" value="{{system.critType}}"/></td></tr>
          {{/if}}
          {{#if system.spellMode}}
          <tr><th scope="row">{{localize "RMF.SpellFailure.Mode"}}</th>
            <td><select name="system.spellMode">
              <option value="attack" {{#if (rmfEq system.spellMode "attack")}}selected{{/if}}>attack</option>
              <option value="nonAttack" {{#if (rmfEq system.spellMode "nonAttack")}}selected{{/if}}>nonAttack</option>
            </select></td></tr>
          {{/if}}
        </tbody>
      </table>
      <table class="summary-table">
        <tbody>
          <tr><th scope="row">{{localize "RMF.AttackTable.Source"}}</th>
            <td><input type="text" name="system.fromBook" value="{{system.fromBook}}"/></td></tr>
        </tbody>
      </table>
    </div>
  </div>

  {{!-- Columns --}}
  <div class="summary-wrapper">
    <h3>{{localize "RMF.TableMatrix.Columns"}}</h3>
    <table class="summary-table">
      <thead><tr><th>{{localize "RMF.TableMatrix.Key"}}</th><th>{{columnLabel}}</th><th></th></tr></thead>
      <tbody>
        {{#each editColumns as |c|}}
        <tr>
          <td><code>{{c.key}}</code></td>
          <td><input type="text" name="system.columnDefs.{{c.index}}.label" value="{{c.label}}"/></td>
          <td><button type="button" class="rmf-icon-btn" data-action="removeColumn" data-key="{{c.key}}" title="{{localize 'RMF.TableMatrix.RemoveColumn'}}"><i class="fas fa-trash"></i></button></td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    <button type="button" class="rmf-add-btn" data-action="addColumn"><i class="fas fa-plus"></i> {{localize "RMF.TableMatrix.AddColumn"}}</button>
  </div>

  {{!-- Editable matrix --}}
  <p class="rmf-edit-hint">{{localize "RMF.TableMatrix.EditHint"}}</p>
  <div class="summary-wrapper attacktable-grid-wrapper">
    <table class="rmf-attack-grid rmf-critical-grid rmf-edit-grid">
      <thead>
        <tr class="armor-ats">
          <th class="roll-col">{{localize "RMF.TableMatrix.Band"}}</th>
          <th>{{localize "RMF.TableMatrix.Min"}}</th>
          <th>{{localize "RMF.TableMatrix.Max"}}</th>
          {{#each editColumns as |c|}}<th class="at-col col-label">{{#if c.label}}{{c.label}}{{else}}{{c.key}}{{/if}}</th>{{/each}}
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{#each editRows as |row|}}
        <tr>
          <td class="roll-col"><input type="text" name="system.rows.{{row.index}}.label" value="{{row.label}}"/></td>
          <td><input type="number" name="system.rows.{{row.index}}.rollMin" value="{{row.rollMin}}" placeholder="—"/></td>
          <td><input type="number" name="system.rows.{{row.index}}.rollMax" value="{{row.rollMax}}"/></td>
          {{#each row.cells as |cell|}}
          <td class="cell crit-cell edit-cell">
            <textarea name="system.rows.{{row.index}}.results.{{cell.key}}.text" rows="2" placeholder="{{localize 'RMF.TableMatrix.Text'}}">{{cell.text}}</textarea>
            <input type="text" name="system.rows.{{row.index}}.results.{{cell.key}}.effects" value="{{cell.effects}}" placeholder="{{localize 'RMF.TableMatrix.Effects'}}"/>
          </td>
          {{/each}}
          <td><button type="button" class="rmf-icon-btn" data-action="removeRow" data-index="{{row.index}}" title="{{localize 'RMF.TableMatrix.RemoveRow'}}"><i class="fas fa-trash"></i></button></td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    <button type="button" class="rmf-add-btn" data-action="addRow"><i class="fas fa-plus"></i> {{localize "RMF.TableMatrix.AddRow"}}</button>
  </div>

  {{!-- Legend --}}
  {{#if legendRows.length}}
  <div class="summary-wrapper">
    <h3>{{localize "RMF.TableMatrix.Legend"}}</h3>
    <table class="summary-table">
      <tbody>
        {{#each legendRows as |row|}}
        <tr><th scope="row"><code>{{row.key}}</code></th>
          <td><input type="text" name="system.legend.{{row.key}}" value="{{row.text}}"/></td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{/if}}

  {{else}}
  <div class="summary-wrapper"><p>{{localize "RMF.TableMatrix.EditOwnerOnly"}}</p></div>
  {{/if}}
</div>
