{{!-- 
  RMF Skill Item Sheet Purchases Partial
  Bought ranks by level (hash level -> amount)
--}}

<div class="tab purchases-section" data-tab="purchases" style="display: none;">
  <section class="purchases-section">

    <p class="hint">Use level keys to track purchases. Example: 1 -> 2, 2 -> 1</p>

    <div class="bought-table-container">
      <table class="bought-table">
        <thead>
          <tr>
            <th>{{localize "RMF.Skill.Level"}}</th>
            <th>{{localize "RMF.Skill.Amount"}}</th>
          </tr>
        </thead>
        <tbody>
          {{#each boughtEntries as |entry i|}}
          <tr>
            <td>
              <input type="text" name="system.boughtByLevel.-={{entry.level}}" value="{{entry.level}}" disabled/>
            </td>
            <td>
              <input type="number" name="system.boughtByLevel.{{entry.level}}" value="{{entry.amount}}" min="0" step="1" inputmode="numeric" data-dtype="Number"/>
            </td>
          </tr>
          {{/each}}
          <tr>
            <td>
              <input type="number" name="system._newLevelKey" value="" min="0" step="1" inputmode="numeric" placeholder="+ level"/>
            </td>
            <td>
              <input type="number" name="system._newLevelValue" value="" min="0" step="1" inputmode="numeric" placeholder="amount"/>
            </td>
          </tr>
        </tbody>
      </table>
      <p class="hint">To add: set both fields, then save.</p>
    </div>

  </section>
</div>

