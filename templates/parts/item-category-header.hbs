{{!-- 
  RMF Category Item Sheet Header Partial
  Category name, image
--}}

<header class="sheet-header">
  <div class="header-row">
    <img class="profile-img"
         src="{{item.img}}"
         alt="{{item.name}}"
         data-edit="img"
         data-action="pickImage"
         title="{{item.name}}"
         height="64"
         width="64"/>

    <div class="header-fields">
      <h1 class="item-name">
        <label class="sr-only" for="category_name">{{localize "RMF.Category.NamePlaceholder"}}:</label>
        <input id="category_name"
               name="name"
               type="text"
               value="{{item.name}}"
               placeholder="{{localize 'RMF.Category.NamePlaceholder'}}"
               autocomplete="off"/>
      </h1>
    </div>
  </div>
</header>
