{{!--
  Reusable table partial for `{name, dpCost: {price1, price2, price3}}`
  rows. Used by both categoryPrice (header "Category") and spellPrice
  (header "SpellGroup").

  Invoke with:
    {{> "parts/profession-dpcost-table"
        rows=… arrayPath="categoryPrice"
        nameHeader="RMF.Skills.Category"
        placeholder="RMF.Skills.Category"}}

    {{> "parts/profession-dpcost-table"
        rows=… readonly=true
        nameHeader="RMF.Profession.SpellGroup"}}

  Hash parameters:
    rows         (Array<{index, name, price1, price2, price3}>)
    arrayPath    (String)   — array path for input names (e.g. "categoryPrice")
    nameHeader   (String)   — i18n key for the leftmost column header
    placeholder  (String, optional) — i18n key for the name <input> placeholder
    readonly     (Boolean, optional)
--}}
<table class="profession-table dp-cost-table">
  <thead>
    <tr>
      <th>{{localize nameHeader}}</th>
      <th>P1</th><th>P2</th><th>P3</th>
    </tr>
  </thead>
  <tbody>
    {{#each rows as |row|}}
    <tr>
      {{#if ../readonly}}
      <td><input type="text"   value="{{row.name}}"   readonly /></td>
      <td><input type="number" value="{{row.price1}}" readonly data-dtype="Number" inputmode="numeric" /></td>
      <td><input type="number" value="{{row.price2}}" readonly data-dtype="Number" inputmode="numeric" /></td>
      <td><input type="number" value="{{row.price3}}" readonly data-dtype="Number" inputmode="numeric" /></td>
      {{else}}
      <td><input type="text"
                 name="system.{{../arrayPath}}.{{row.index}}.name"
                 value="{{row.name}}"
                 placeholder="{{localize ../placeholder}}"
                 autocomplete="off" /></td>
      <td><input type="number" name="system.{{../arrayPath}}.{{row.index}}.dpCost.price1" value="{{row.price1}}" min="-99" max="999" step="1" inputmode="numeric" data-dtype="Number" /></td>
      <td><input type="number" name="system.{{../arrayPath}}.{{row.index}}.dpCost.price2" value="{{row.price2}}" min="-99" max="999" step="1" inputmode="numeric" data-dtype="Number" /></td>
      <td><input type="number" name="system.{{../arrayPath}}.{{row.index}}.dpCost.price3" value="{{row.price3}}" min="-99" max="999" step="1" inputmode="numeric" data-dtype="Number" /></td>
      {{/if}}
    </tr>
    {{/each}}
  </tbody>
</table>
