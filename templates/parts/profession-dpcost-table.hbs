{{!--
  Reusable table partial for `{name, dpCost}` rows, where `dpCost` is the RMF
  slash-notation string ("2/5", "2/2/2", "20", "3/*" = ilimitado, "" = sin
  coste). Used by both categoryPrice (header "Category") and spellPrice
  (header "SpellGroup").

  Invoke with:
    {{> "parts/profession-dpcost-table"
        rows=… arrayPath="categoryPrice"
        nameHeader="RMF.Skills.Category"
        placeholder="RMF.Skills.Category"}}

    {{> "parts/profession-dpcost-table"
        rows=… readonly=true
        nameHeader="RMF.Profession.SpellGroup"}}

  Hash parameters:
    rows         (Array<{index, name, dpCost}>)
    arrayPath    (String)   — array path for input names (e.g. "categoryPrice")
    nameHeader   (String)   — i18n key for the leftmost column header
    placeholder  (String, optional) — i18n key for the name <input> placeholder
    readonly     (Boolean, optional)
--}}
<table class="profession-table dp-cost-table">
  <thead>
    <tr>
      <th>{{localize nameHeader}}</th>
      <th>{{localize "RMF.Category.DPCost"}}</th>
    </tr>
  </thead>
  <tbody>
    {{#each rows as |row|}}
    <tr>
      {{#if ../readonly}}
      <td><input type="text" value="{{row.name}}"   readonly /></td>
      <td><input type="text" value="{{row.dpCost}}" readonly /></td>
      {{else}}
      <td><input type="text"
                 name="system.{{../arrayPath}}.{{row.index}}.name"
                 value="{{row.name}}"
                 placeholder="{{localize ../placeholder}}"
                 autocomplete="off" /></td>
      <td><input type="text"
                 name="system.{{../arrayPath}}.{{row.index}}.dpCost"
                 value="{{row.dpCost}}"
                 placeholder="2/5"
                 autocomplete="off" /></td>
      {{/if}}
    </tr>
    {{/each}}
  </tbody>
</table>
