{{!--
  RMF Profession Item Sheet Advanced Partial
  Editable view: description, source, prime stats, professional bonuses,
  skill lists, dpCost tables, training packages.
--}}

<div class="tab advanced-section" data-group="primary-tabs" data-tab="advanced">

  {{!-- Description --}}
  <fieldset class="form-group">
    <legend>{{localize "RMF.Description"}}</legend>
    <div class="editor-container description-editor">
      <textarea name="system.description"
                style="height: 160px; resize: vertical;"
                placeholder="{{localize 'RMF.DescriptionPlaceholder'}}">{{system.description}}</textarea>
    </div>
  </fieldset>

  {{!-- Source --}}
  <fieldset class="form-group">
    <legend>{{localize "RMF.Category.Source"}}</legend>
    <input type="text"
           name="system.fromBook"
           value="{{system.fromBook}}"
           placeholder="basic"
           autocomplete="off" />
  </fieldset>

  {{!-- Prime stats: select inputs (canonical chXxx values).
       Each row carries its own `options` array with `selected` pre-stamped
       by the sheet, so the template avoids a fragile `../row.name` path. --}}
  <fieldset class="form-group">
    <legend>{{localize "RMF.Profession.PrimeStats"}}</legend>
    <div class="prime-stats-grid">
      {{#each primeStatRows as |row|}}
      <div class="prime-stat-row">
        <select name="system.primeStats.{{row.index}}">
          {{#each row.options as |opt|}}
            <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
          {{/each}}
        </select>
      </div>
      {{/each}}
    </div>
    <p class="hint">{{localize "RMF.Profession.PrimeStatsHint"}}</p>
  </fieldset>

  {{!-- Professional bonuses — two-column layout for compactness --}}
  <fieldset class="form-group">
    <legend>{{localize "RMF.Profession.ProfessionalBonuses"}}</legend>
    <div class="two-col-tables">
      {{> "parts/profession-bonus-table" rows=professionalBonusesLeft  arrayPath="professionalBonuses"}}
      {{> "parts/profession-bonus-table" rows=professionalBonusesRight arrayPath="professionalBonuses"}}
    </div>
  </fieldset>

  {{!-- Everyman skills --}}
  <fieldset class="form-group">
    <legend>{{localize "RMF.Profession.EverymanSkills"}}</legend>
    <div class="profession-skill-grid">
      {{#each everymanSkillRows as |row|}}
      <div class="profession-skill-row">
        <input type="text"
               name="system.everymanSkills.{{row.index}}.name"
               value="{{row.name}}"
               placeholder="{{localize 'RMF.Skills.Title'}}"
               autocomplete="off" />
      </div>
      {{/each}}
    </div>
  </fieldset>

  {{!-- Occupational skills --}}
  <fieldset class="form-group">
    <legend>{{localize "RMF.Profession.OccupationalSkills"}}</legend>
    <div class="profession-skill-grid">
      {{#each occupationalSkillRows as |row|}}
      <div class="profession-skill-row">
        <input type="text"
               name="system.occupationalSkills.{{row.index}}.name"
               value="{{row.name}}"
               placeholder="{{localize 'RMF.Skills.Title'}}"
               autocomplete="off" />
      </div>
      {{/each}}
    </div>
  </fieldset>

  {{!-- Restricted skills --}}
  <fieldset class="form-group">
    <legend>{{localize "RMF.Profession.RestrictedSkills"}}</legend>
    <div class="profession-skill-grid">
      {{#each restrictedSkillRows as |row|}}
      <div class="profession-skill-row">
        <input type="text"
               name="system.restrictedSkills.{{row.index}}.name"
               value="{{row.name}}"
               placeholder="{{localize 'RMF.Skills.Title'}}"
               autocomplete="off" />
      </div>
      {{/each}}
    </div>
  </fieldset>

  {{!-- Category prices — two-column layout for compactness --}}
  <fieldset class="form-group">
    <legend>{{localize "RMF.Profession.CategoryPrice"}}</legend>
    <div class="two-col-tables">
      {{> "parts/profession-dpcost-table" rows=categoryPriceLeft  arrayPath="categoryPrice" nameHeader="RMF.Skills.Category" placeholder="RMF.Skills.Category"}}
      {{> "parts/profession-dpcost-table" rows=categoryPriceRight arrayPath="categoryPrice" nameHeader="RMF.Skills.Category" placeholder="RMF.Skills.Category"}}
    </div>
  </fieldset>

  {{!-- Spell prices — two-column layout for compactness --}}
  <fieldset class="form-group">
    <legend>{{localize "RMF.Profession.SpellPrice"}}</legend>
    <div class="two-col-tables">
      {{> "parts/profession-dpcost-table" rows=spellPriceLeft  arrayPath="spellPrice" nameHeader="RMF.Profession.SpellGroup" placeholder="RMF.Profession.SpellGroup"}}
      {{> "parts/profession-dpcost-table" rows=spellPriceRight arrayPath="spellPrice" nameHeader="RMF.Profession.SpellGroup" placeholder="RMF.Profession.SpellGroup"}}
    </div>
  </fieldset>

  {{!-- Training packages — two-column layout for compactness --}}
  <fieldset class="form-group">
    <legend>{{localize "RMF.Profession.TrainingPackages"}}</legend>
    <div class="two-col-tables">
      {{> "parts/profession-training-table" rows=trainingPackagesLeft  arrayPath="trainingPackages"}}
      {{> "parts/profession-training-table" rows=trainingPackagesRight arrayPath="trainingPackages"}}
    </div>
  </fieldset>

</div>
